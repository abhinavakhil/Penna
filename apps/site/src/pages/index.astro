    .dcard:hover { border-color: rgba(255,255,255,.2); background: rgba(255,255,255,.06); }
    .dicon { width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; margin-bottom: 16px; color: #a5b4fc; background: linear-gradient(145deg, rgba(139,140,248,.22), rgba(34,211,238,.12)); box-shadow: inset 0 0 0 1px rgba(165,180,252,.25); }
    .dicon :global(.ph) { font-size: 22px; }
    .dicon :global(.ph [opacity]) { fill: #67e8f9; opacity: .35; }
    .dcard h3 { font-size: 16px; margin-bottom: 8px; color: #fff; }
