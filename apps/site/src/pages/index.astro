    .compare td :global(.yes [opacity]) { fill: #16a34a; }
    .compare td :global(.nope) { color: var(--muted); opacity: .7; }
    .fine { font-size: 12px; color: var(--muted); margin-top: 14px; }

    /* ---- render ---- */
    .two { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }

    /* ---- stats ---- */
    .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); text-align: left; border-top: 1px solid var(--line); }
