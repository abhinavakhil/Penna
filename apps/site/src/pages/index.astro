    .icon { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; flex: none; color: var(--accent); background: linear-gradient(145deg, color-mix(in srgb, var(--accent) 14%, var(--card)), color-mix(in srgb, var(--accent-2) 10%, var(--card))); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 20%, transparent), 0 6px 16px -8px color-mix(in srgb, var(--accent) 45%, transparent); margin-bottom: 18px; transition: transform .25s cubic-bezier(.2,.7,.2,1); }
