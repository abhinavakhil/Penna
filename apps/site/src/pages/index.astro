    .stat .label { display: inline-flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); }
    .stat .label :global(.ph) { font-size: 18px; color: var(--accent); }
    .stat .num { display: block; font-family: "Plus Jakarta Sans", Inter, sans-serif; font-size: clamp(56px, 6.5vw, 96px); font-weight: 700; letter-spacing: -.06em; line-height: 1; margin: 14px 0 12px; color: var(--fg); }
    .stat p { margin: 0; font-size: 15px; line-height: 1.5; color: var(--muted); max-width: 26ch; }

    /* ---- final ---- */
    .final { text-align: center; padding: 80px 24px; margin-top: 120px; border: 1px solid var(--line); border-radius: 28px; background: radial-gradient(80% 100% at 50% 0%, color-mix(in srgb, var(--accent) 10%, var(--card)), var(--card)); }
    .final .cta { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; align-items: center; margin-top: 26px; }
    .btn.lg { padding: 14px 24px; font-size: 15px; border-radius: 12px; }
    .pill { display: inline-flex; align-items: center; gap: 8px; background: var(--code); color: var(--fg); border: 1px solid var(--line); padding: 12px 16px; border-radius: 12px; font: inherit; font-size: 13px; cursor: pointer; }
    .pill :global(.ph) { font-size: 18px; color: var(--accent); }
    .btn :global(.ph) { font-size: 18px; }
    .grad-final { background: linear-gradient(90deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }

    @media (max-width: 960px) { .bento { grid-template-columns: repeat(2, 1fr); } .stat-grid { grid-template-columns: repeat(2, 1fr); } .stat:nth-child(2) { border-right: 0; margin-right: 0; } .three { grid-template-columns: 1fr; } }
    @media (max-width: 800px) {
      .hero-inner { padding: 44px 20px 40px; gap: 16px; }
      .hero h1 { font-size: clamp(34px, 9.5vw, 44px); letter-spacing: -.03em; }
      .hero h1 .sec { font-size: clamp(20px, 5.6vw, 26px); }
      .cta-row { flex-wrap: wrap; gap: 12px 16px; }
      .demo-hint { display: block; white-space: normal; line-height: 1.6; }
      .demo-hint::before { display: none; }
      .tabs-inner { flex-direction: column; }
      .demo-nav { width: auto; flex-direction: row; overflow-x: auto; padding: 12px 0; scrollbar-width: none; }
      .demo-nav button { white-space: nowrap; flex: none; }
      .preview { width: 100%; }
      .tabs-wrap { height: 520px; }
      .demo-frame :global(.penna) { min-height: 420px; }
      .two, .dark-grid { grid-template-columns: 1fr; }
      .dcard.span2 { grid-column: auto; }
      .micro br { display: none; }
    }
    @media (max-width: 640px) {
      section.problem, section.features, section.install, section.ai, section.compare, section.render, section.stats { padding-top: 72px; }
      section h2 { font-size: clamp(28px, 8vw, 34px); }
      .sub-sm { font-size: 15px; margin-bottom: 24px; }
      .strip { margin-top: 32px; }
      .marquee span { font-size: 18px; padding-right: 36px; }
      .marquee svg { width: 20px; height: 20px; }
