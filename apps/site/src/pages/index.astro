    /* ---- dark AI ---- */
    .dark { background: #0b0d12; color: #e7e9ee; border-radius: 28px; padding: clamp(28px, 5vw, 64px); position: relative; overflow: hidden; }
    .dark::before { content: ""; position: absolute; inset: 0; background: radial-gradient(50% 40% at 30% 0%, color-mix(in srgb, #8b8cf8 25%, transparent), transparent 70%), radial-gradient(40% 40% at 90% 100%, color-mix(in srgb, #22d3ee 18%, transparent), transparent 70%); pointer-events: none; }
