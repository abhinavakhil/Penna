      .final h2 br { display: none; }
      .final .cta { flex-direction: column; }
      .final .cta .btn, .final .cta .pill { width: 100%; justify-content: center; text-align: center; box-sizing: border-box; }
      .stat .num { font-size: 56px; }
    }
    @media (max-width: 560px) { .bento { grid-template-columns: 1fr; } .tile.big, .tile.wide { grid-column: auto; grid-row: auto; } .stat-grid { grid-template-columns: 1fr; } .stat { border-right: 0; margin-right: 0; border-bottom: 1px solid var(--line); padding-bottom: 24px; } }
  </style>

  <script>
    import { createEditor, shortcuts, fundraisingShortcuts, proofread } from '@abhinavakhil/penna-core'
    import { ai } from '@abhinavakhil/penna-ai'
    const key = localStorage.getItem('penna-ai-key') || ''
    const provider = (localStorage.getItem('penna-ai-provider') as any) || 'groq'

    const TOUR: Record<string, string> = {
      slash: `<h1>Slash commands</h1><p>Put the cursor on an empty line and type <code>/</code>. Headings, lists, tables, images, callouts, code, embeds and AI, all fuzzy-searchable from the keyboard.</p><p></p><div data-callout="⌘"><p>Try it now: click the empty line above and press <kbd>/</kbd>.</p></div>`,
      shortcuts: `<h1>Shortcuts</h1><p>Type <code>/budget</code>, <code>/impact</code> or <code>/milestones</code> on an empty line, or press <kbd>Ctrl</kbd>+<kbd>Alt</kbd>+<kbd>B</kbd>. A ready-made block drops in, and every cell stays editable.</p><p></p><div data-callout="⭐"><p>Select any text and press <strong>+</strong> in the bubble to save it as your own shortcut.</p></div>`,
      proofread: `<h1>Proofreader</h1><p>We definately need more volunteers in order to finish the beach clean before the tide comes in.</p><p>Click an underline to see the fix. Spelling, wordy phrases and long sentences are flagged as you type, and nothing changes until you accept.</p>`,
      bubble: `<h1>Bubble menu</h1><p>Select any of this text and the formatting you need appears right where you are. <strong>Bold</strong>, <em>italic</em>, <code>code</code>, <a href="https://penna.dev">links</a>, <mark>highlight</mark>, AI, and <strong>Turn into</strong> for any block type.</p><p>No toolbar to hunt through. No modes to toggle.</p>`,
      tables: `<h1>Real tables</h1><table><tr><th><p>Feature</p></th><th><p>Penna</p></th><th><p>Others</p></th></tr><tr><td><p>Merge cells</p></td><td><p>✅ select two cells</p></td><td><p>Plugin</p></td></tr><tr><td><p>Resize columns</p></td><td><p>✅ drag the edge</p></td><td><p>✗</p></td></tr><tr><td><p>Header rows</p></td><td><p>✅</p></td><td><p>Partial</p></td></tr></table><p>Add rows and columns from the handle, merge by selecting cells, resize by dragging.</p>`,
      tasks: `<h1>Task lists</h1><ul data-task=""><li data-checked="true"><p>Real checkboxes that toggle</p></li><li data-checked="true"><p>Serialize to <code>- [x]</code> Markdown</p></li><li data-checked="false"><p>Render outside the editor with <code>renderToHTML</code></p></li><li data-checked="false"><p>Click one of these boxes</p></li></ul>`,
      markdown: `<h1>Markdown in &amp; out</h1><p>Type <code>**bold**</code>, <code># heading</code>, <code>- [ ] task</code> or <code>\`\`\`</code> and Penna converts as you go. Import and export lossless Markdown, HTML or JSON.</p><pre data-language="md"><code>## Shipping notes
- [x] Tables merge and resize
- [ ] Try pasting **this** somewhere</code></pre>`,
      ai: `<h1>Ask AI</h1><p>Select text or press <kbd>Ctrl</kbd>+<kbd>J</kbd>. Continue writing, improve, fix grammar, shorten, translate, or type any instruction. It streams into a preview and nothing is inserted until you accept.</p><div data-callout="⚡"><p>Free presets for Groq, Gemini and OpenRouter. Add a key in the playground to try it here.</p></div>`,
    }
    const editor = ((window as any).penna = createEditor('#hero-editor', {
      autofocus: false,
      theme: (document.documentElement.dataset.theme as any) || 'auto',
      extensions: [ai({ provider, apiKey: key, onError: (e) => alert(e.message + '\n\nAdd a free key in the Playground → AI settings.') }), shortcuts({ items: fundraisingShortcuts }), proofread()],
      content: TOUR.slash,
    }))

    // ---- feature tour: click or auto-cycle, pauses while the editor is in use
    const demo = document.querySelector<HTMLElement>('.demo')!
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('.demo-nav [role=tab]')]
    const TOUR_MS = 6000
    let idx = 0, timer = 0, dirty = false
    const show = (i: number) => {
      idx = i
      tabs.forEach((t, j) => t.setAttribute('aria-selected', String(j === i)))
      editor.setHTML(TOUR[tabs[i].dataset.tour!])
      dirty = false
      schedule()
    }
    const schedule = () => { clearTimeout(timer); timer = window.setTimeout(() => { if (!dirty && !demo.classList.contains('paused')) show((idx + 1) % tabs.length); else schedule() }, TOUR_MS) }
    tabs.forEach((t, i) => t.addEventListener('click', () => show(i)))
    const frame = document.querySelector<HTMLElement>('.demo-frame')!
    frame.addEventListener('pointerenter', () => demo.classList.add('paused'))
    frame.addEventListener('pointerleave', () => { if (!frame.contains(document.activeElement)) demo.classList.remove('paused') })
    frame.addEventListener('focusin', () => { demo.classList.add('paused'); dirty = true })
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) schedule()

    // ---- scroll reveal
    const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target) } }), { rootMargin: '0px 0px -10% 0px' })
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el))

    // ---- count-up stats
    const counters = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return
      counters.unobserve(e.target)
      const el = e.target as HTMLElement, target = Number(el.dataset.count), t0 = performance.now()
      if (!Number.isFinite(target) || matchMedia('(prefers-reduced-motion: reduce)').matches) return
      const tick = (t: number) => { const p = Math.min(1, (t - t0) / 900); el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3)))); if (p < 1) requestAnimationFrame(tick) }
      requestAnimationFrame(tick)
    }), { threshold: .6 })
    document.querySelectorAll('.num').forEach((el) => counters.observe(el))

    // ---- install tabs
    document.querySelectorAll<HTMLButtonElement>('.tabs [role=tab]').forEach((b) =>
      b.addEventListener('click', () => {
        document.querySelectorAll('.tabs [role=tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)))
        document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab))
      }),
    )
    const copy = document.getElementById('copy')!
    copy.parentElement!.addEventListener('click', () => { navigator.clipboard.writeText('npm i @abhinavakhil/penna-core'); copy.textContent = 'copied!'; setTimeout(() => (copy.textContent = 'npm i @abhinavakhil/penna-core'), 1200) })
  </script>
