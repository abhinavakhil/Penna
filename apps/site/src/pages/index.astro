    /* ---- bento ---- */
    .bento { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; text-align: left; }
    .tile.big { grid-column: span 2; grid-row: span 2; display: flex; flex-direction: column; }
    .tile h3 { font-size: 16px; margin-bottom: 6px; }
