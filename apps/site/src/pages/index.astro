---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { siReact, siVuedotjs, siAngular, siSvelte, siSolid, siHtml5, siAstro, siNextdotjs, siNuxt } from 'simple-icons'

const features = [
  ['cursor-text', 'Bubble menu', 'Select text and the formatting you need appears right there. Bold, links, highlight, AI, and <b>Turn into</b> any block type.'],
  ['lightning', 'Shortcuts', 'Type <code>/budget</code> or <code>/impact</code>, or hit a hotkey, to drop in ready-made blocks. Select anything and press <kbd>+</kbd> to save your own.'],
  ['seal-check', 'Proofreader', 'Typos, wordy phrases and hard-to-read sentences get underlined as you write. One click to fix, and a live score. Nothing changes unless you accept.'],
  ['clock-counter-clockwise', 'Version history', 'Quiet autosaves, named versions, a word-by-word diff against now, and one-click restore. Pin comments to the exact words, too.'],
  ['at', 'Mentions & merge fields', 'Type <kbd>@</kbd> to mention someone from your API, or <code>{{first_name}}</code> for per-reader fields you can preview with real values.'],
  ['hand-grabbing', 'Drag handles', 'Grab any block and move it. Click <kbd>+</kbd> to insert below. Notion-smooth, zero config.'],
  ['image', 'Images & video', 'Drop, paste or upload. Resize by dragging, align, alt text. Inline by default, or bring your own storage.'],
  ['play-circle', 'Embeds', 'Paste a YouTube, Vimeo, Loom, Figma or CodePen link and it just becomes the thing.'],
  ['table', 'Real tables', 'Add rows and columns, merge cells, header rows, drag to resize columns. Not an afterthought.'],
  ['markdown-logo', 'Markdown in & out', 'Type <code>**bold**</code>, <code># heading</code>, <code>- [ ] task</code>. Import and export lossless Markdown, HTML or JSON.'],
  ['magnifying-glass', 'Find & replace', 'With match counts, case toggle and replace-all. <kbd>Ctrl</kbd>+<kbd>F</kbd> like you\'d expect.'],
  ['list-checks', 'Task lists', 'Real checkboxes that toggle, serialize to <code>- [x]</code> Markdown and render outside the editor.'],
  ['circle-half', 'Light, dark, sepia & RTL', 'Follows your app\'s theme or the system. Right-to-left for Urdu and Arabic, a focus mode that dims all but the current sentence, and every color is a CSS variable.'],
  ['browsers', 'Render anywhere', '<code>renderToHTML(json)</code> needs no DOM. Show saved content on the server, in an email, in a PDF pipeline.'],
]

const compare: [string, string, string, string, string][] = [
  ['Works in any framework', '✓ incl. Angular forms', 'React only', 'Vanilla + wrappers', '✓ (jQuery-era API)'],
  ['Slash commands & bubble menu', '✓', '✓', '✗', 'Partial'],
  ['Drag handles', '✓', '✓', '✗', '✗'],
  ['Tables with merge / resize', '✓', '✗', 'Plugin', '✓'],
  ['Images, video, embeds', '✓', 'Images', 'Images', '✓'],
  ['Markdown import & export', '✓ lossless', 'Input only', '✗ (Delta)', '✗'],
  ['Render content without the editor', '✓ no DOM needed', '✗', '✗', '✗'],
  ['Built-in AI', '✓ free providers', 'OpenAI only', '✗', '✗'],
  ['Find & replace, word count, autosave', '✓', '✗', '✗', 'Plugins'],
  ['Dark mode & CSS variables', '✓ light, dark, sepia', 'Tailwind only', 'Themes', '✗'],
  ['License', 'MIT, no telemetry', 'Apache-2.0', 'BSD', 'Paid, license key'],
]

const installs = {
  html: `<span class="c">&lt;!-- one script tag, no build step --&gt;</span>
<span class="k">&lt;link</span> rel="stylesheet" href="https://unpkg.com/@abhinavakhil/penna-core/dist/penna.css"<span class="k">&gt;</span>
<span class="k">&lt;script</span> type="module" src="https://unpkg.com/@abhinavakhil/penna-element"<span class="k">&gt;&lt;/script&gt;</span>

<span class="k">&lt;penna-editor</span> placeholder="Write something…"<span class="k">&gt;&lt;/penna-editor&gt;</span>`,
  react: `<span class="k">import</span> { Penna } <span class="k">from</span> <span class="s">'@abhinavakhil/penna-react'</span>
<span class="k">import</span> <span class="s">'@abhinavakhil/penna-core/penna.css'</span>

<span class="k">export default function</span> <span class="f">Page</span>() {
  <span class="k">const</span> [html, setHtml] = <span class="f">useState</span>(<span class="s">''</span>)
  <span class="k">return</span> <span class="k">&lt;Penna</span> value={html} onChange={({ html }) =&gt; <span class="f">setHtml</span>(html)} <span class="k">/&gt;</span>
}`,
  vue: `<span class="k">&lt;script setup&gt;</span>
<span class="k">import</span> { Penna } <span class="k">from</span> <span class="s">'@abhinavakhil/penna-vue'</span>
<span class="k">import</span> <span class="s">'@abhinavakhil/penna-core/penna.css'</span>
<span class="k">const</span> html = <span class="f">ref</span>(<span class="s">''</span>)
<span class="k">&lt;/script&gt;</span>

<span class="k">&lt;template&gt;</span>
  <span class="k">&lt;Penna</span> v-model="html" placeholder="Write something…" <span class="k">/&gt;</span>
<span class="k">&lt;/template&gt;</span>`,
  angular: `<span class="k">import</span> { PennaEditorComponent } <span class="k">from</span> <span class="s">'@abhinavakhil/penna-angular'</span>
<span class="c">// angular.json styles: "node_modules/@abhinavakhil/penna-core/dist/penna.css"</span>

@<span class="f">Component</span>({
  imports: [PennaEditorComponent, FormsModule],
  template: <span class="s">\`&lt;ngx-penna [(ngModel)]="html" placeholder="Write something…" /&gt;\`</span>,
})
<span class="k">export class</span> <span class="f">Editor</span> { html = <span class="s">''</span> }`,
  svelte: `<span class="k">&lt;script&gt;</span>
  <span class="k">import</span> <span class="s">'@abhinavakhil/penna-element'</span>
  <span class="k">import</span> <span class="s">'@abhinavakhil/penna-core/penna.css'</span>
  <span class="k">let</span> html = <span class="s">''</span>
<span class="k">&lt;/script&gt;</span>

<span class="k">&lt;penna-editor</span> value={html} on:change={(e) =&gt; (html = e.detail.html)} <span class="k">/&gt;</span>`,
  vanilla: `<span class="k">import</span> { createEditor } <span class="k">from</span> <span class="s">'@abhinavakhil/penna-core'</span>
<span class="k">import</span> <span class="s">'@abhinavakhil/penna-core/penna.css'</span>

<span class="k">const</span> editor = <span class="f">createEditor</span>(<span class="s">'#editor'</span>, {
  placeholder: <span class="s">'Write something…'</span>,
  onUpdate: (e) =&gt; <span class="f">save</span>(e.<span class="f">getJSON</span>()),
})`,
}
const aiSnippet = `<span class="k">import</span> { createEditor } <span class="k">from</span> <span class="s">'@abhinavakhil/penna-core'</span>
<span class="k">import</span> { ai } <span class="k">from</span> <span class="s">'@abhinavakhil/penna-ai'</span>

<span class="f">createEditor</span>(<span class="s">'#editor'</span>, {
  extensions: [
    <span class="f">ai</span>({
      provider: <span class="s">'groq'</span>,      <span class="c">// free at console.groq.com</span>
      apiKey: GROQ_KEY,
    }),
  ],
})

<span class="c">// or any OpenAI-compatible API:</span>
<span class="f">ai</span>({ provider: <span class="s">'openai-compatible'</span>,
     baseUrl: <span class="s">'https://your-proxy.dev/v1'</span>,
     model: <span class="s">'gpt-4o-mini'</span> })`
const renderSnippet = `<span class="c">// server, edge, worker — no DOM required</span>
<span class="k">import</span> { renderToHTML } <span class="k">from</span> <span class="s">'@abhinavakhil/penna-core'</span>

<span class="k">const</span> html = <span class="f">renderToHTML</span>(post.content)
<span class="c">// same markup the editor produces,</span>
<span class="c">// styled by the same penna.css</span>
<span class="k">return</span> <span class="s">\`&lt;article class="penna-content"&gt;\${html}&lt;/article&gt;\`</span>`

const slashCount = 16
const tour = [['slash', 'Slash commands', 'command'], ['shortcuts', 'Shortcuts', 'lightning'], ['bubble', 'Bubble menu', 'cursor-text'], ['proofread', 'Proofreader', 'seal-check'], ['tables', 'Tables', 'table'], ['tasks', 'Task lists', 'list-checks'], ['markdown', 'Markdown', 'markdown-logo'], ['ai', 'Ask AI', 'sparkle']]
const stack = [['React', siReact], ['Vue', siVuedotjs], ['Angular', siAngular], ['Svelte', siSvelte], ['Solid', siSolid], ['Plain HTML', siHtml5], ['Astro', siAstro], ['Next.js', siNextdotjs], ['Nuxt', siNuxt]] as const
const problems = [
  ['Framework lock-in', 'Most editors are React-only or ship a jQuery-era API. Penna is a plain element with thin React, Vue and Angular wrappers, so one editor serves <b>every</b> app you own.', 'Portability', 'plugs'],
  ['The plugin hunt', 'Tables, images, embeds, find & replace, task lists: usually five plugins from five authors. Here they are one import, tested together, styled together.', 'Batteries', 'puzzle-piece'],
  ['AI behind a paywall', 'Built-in AI elsewhere means one vendor and a bill. Penna ships free Groq, Gemini and OpenRouter presets, plus Ollama for fully local.', 'Free AI', 'coins'],
]
const aiCards: [string, string, string[] | null, string][] = [
  ['Free providers built in', 'Presets for every free tier, plus Ollama for fully local. Any OpenAI-compatible endpoint is one line.', ['Groq', 'Gemini', 'OpenRouter', 'Together', 'Ollama', 'OpenAI', 'Mistral'], 'gift'],
  ['Every writing action', 'Continue, improve, fix grammar, shorten, expand, simplify, summarize, translate, change tone, or type any instruction.', null, 'magic-wand'],
  ['Preview before insert', 'Responses stream into a preview, and rewrites show a word-by-word diff. Accept, retry, or discard. Nothing touches the document until you say so.', null, 'eye'],
  ['Your key stays yours', 'Requests go straight from the browser to the provider you chose. Nothing is sent until you trigger an action.', null, 'lock-key'],
]
const stats = [
  ['6', 'Frameworks', 'browsers', 'React, Vue, Angular, Svelte, Solid and plain HTML, from one package.'],
  ['16', 'Slash blocks', 'squares-four', 'Headings, lists, tables, media, callouts, code, embeds and AI.'],
  ['5', 'Free AI presets', 'sparkle', 'Groq, Gemini, OpenRouter, Together and Ollama, no card required.'],
  ['0', 'Telemetry', 'shield-check', 'MIT licensed. No tracking, no phone-home, no license key.'],
]
---
<Base>
  <section class="hero">
    <div class="hero-inner">
      <a class="pill-tag rise" style="--i:0" href="/playground">NEW · Shortcuts, proofreader &amp; Angular <span aria-hidden="true">›</span></a>
      <h1 class="rise" style="--i:1"><span class="pri">The rich text editor<br />people actually enjoy.</span><span class="sec">Notion-feel editing. Smart shortcuts. Free AI.</span></h1>
      <div class="cta-row rise" style="--i:2">
        <a class="btn-hero" href="/playground">Try it. It's free.<Icon name="arrow-right" /></a>
        <span class="micro">MIT licensed.<br />No sign-up. No credit card.</span>
      </div>
    </div>
    <div class="tabs-wrap rise" style="--i:3">
      <div class="tabs-inner demo">
        <div class="demo-nav" role="tablist" aria-label="Feature tour">
          {tour.map(([id, label, icon], i) => <button role="tab" data-tour={id} aria-selected={i === 0 ? 'true' : 'false'}><Icon name={icon} />{label}</button>)}
        </div>
        <div class="preview">
          <div class="demo-frame">
            <div class="demo-hint">Live editor. Select text, type <kbd>/</kbd>, drop an image, or press <kbd>Ctrl</kbd>+<kbd>F</kbd></div>
            <div id="hero-editor"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="strip" aria-label="Works with every framework">
    <p class="eyebrow-muted">Drops into any stack</p>
    <div class="marquee"><div class="track">{[...stack, ...stack, ...stack, ...stack].map(([name, si]) => <span style={`--brand:${{ Angular: '#DD0031', Solid: '#4F88C6', 'Next.js': 'var(--fg)' }[name as string] ?? '#' + si.hex}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={si.path} /></svg>{name}</span>)}</div></div>
  </section>

  <section class="wrap problem reveal">
    <h2>Most editors make you <span class="fade">choose.</span></h2>
    <p class="sub-sm">Framework lock-in, plugin hunts, and AI behind a paywall. Penna skips all three.</p>
    <div class="three">
      {problems.map(([title, body, tag, icon], i) => (
        <div class="card prob reveal" style={`--i:${i}`}>
          <div class="prob-top"><span class="icon"><Icon name={icon} /></span><span class="tag">{tag}</span></div>
          <h3>{title}</h3>
          <p set:html={body} />
        </div>
      ))}
    </div>
  </section>

  <section class="wrap features reveal" id="features">
    <h2>Everything included. <span class="fade">Nothing to hunt for.</span></h2>
    <p class="sub-sm">Every block, menu and shortcut ships in the box and works the same in every framework.</p>
    <div class="bento">
      <div class="card tile big reveal" style="--i:0">
        <div class="mock slash" aria-hidden="true">
          <div class="mock-line">Type <b>/</b> to insert</div>
          <div class="mock-menu">
            {[['Heading', 'text-h'], ['Task list', 'list-checks'], ['Table', 'table'], ['Image', 'image'], ['Callout', 'info'], ['Ask AI', 'sparkle']].map(([m, ic], i) => <div class="mock-item" style={`--i:${i}`}><i><Icon name={ic} /></i>{m}<kbd>{i === 0 ? '↵' : ''}</kbd></div>)}
          </div>
        </div>
        <h3>Slash commands</h3>
        <p>Type <kbd>/</kbd> for {slashCount} blocks: headings, lists, tables, media, callouts and AI. Fuzzy search, keyboard-first.</p>
      </div>
      <div class="card tile big reveal" style="--i:1">
        <div class="mock stream" aria-hidden="true">
          <div class="mock-ask"><Icon name="sparkle" /> Continue writing</div>
          <p class="typed">Penna streams the answer into a preview. Accept, retry, or discard, nothing lands in your doc until you say so.</p>
        </div>
        <h3>AI that's free</h3>
        <p>Continue, improve, fix, translate, summarize. Ships with free Groq, Gemini and OpenRouter presets. Any OpenAI-compatible key works.</p>
      </div>
      {features.map(([icon, title, body], i) => (
        <div class:list={["card tile reveal", { wide: i >= features.length - 2 }]} style={`--i:${i + 2}`}>
          <div class="icon"><Icon name={icon} /></div>
          <h3>{title}</h3>
          <p set:html={body} />
        </div>
      ))}
    </div>
  </section>

  <section class="wrap install reveal" id="install">
    <h2>Two minutes to <span class="fade">ship.</span></h2>
    <p class="sub-sm">Pick your framework. Same editor, same features, same CSS file.</p>
    <div class="tabs" role="tablist">
      {Object.keys(installs).map((k, i) => <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={k}>{k === 'html' ? 'HTML' : k[0].toUpperCase() + k.slice(1)}</button>)}
    </div>
    {Object.entries(installs).map(([k, code], i) => <pre class="code" data-panel={k} hidden={i !== 0} set:html={code}></pre>)}
  </section>

  <section class="wrap ai reveal" id="ai">
    <div class="dark">
      <div class="dark-head">
        <span class="eyebrow light">AI, without the bill</span>
        <h2>Free AI out of the box.<br /><span class="fade-light">Paid models if you want them.</span></h2>
      </div>
      <div class="dark-grid">
        {aiCards.map(([title, body, chips, icon], i) => (
          <div class="dcard reveal" style={`--i:${i}`}>
            <span class="dicon"><Icon name={icon} /></span>
            <h3>{title}</h3>
            <p>{body}</p>
            {chips && <div class="chips">{chips.map((c) => <span>{c}</span>)}</div>}
          </div>
        ))}
        <pre class="code dcard span2 reveal" style="--i:4" set:html={aiSnippet}></pre>
      </div>
    </div>
  </section>

  <section class="wrap compare reveal">
    <h2>What the others make you <span class="fade">work around.</span></h2>
    <p class="sub-sm">Side by side with the editors you'd otherwise reach for.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th></th><th class="us">Penna</th><th>Novel</th><th>Quill</th><th>Froala</th></tr></thead>
        <tbody>
          {compare.map(([label, ...cells]) => <tr><td>{label}</td>{cells.map((c, i) => <td class:list={{ us: i === 0, no: c.startsWith('✗') }}>{c.startsWith('✓') ? <><Icon name="check-circle" class="yes" />{c.slice(1)}</> : c.startsWith('✗') ? <><Icon name="x-circle" class="nope" />{c.slice(1)}</> : c}</td>)}</tr>)}
        </tbody>
      </table>
    </div>
    <p class="fine">Comparison reflects default, out-of-the-box behaviour of each project at time of writing.</p>
  </section>

  <section class="wrap render reveal">
    <div class="two">
      <pre class="code" set:html={renderSnippet}></pre>
      <div>
        <span class="eyebrow">Show it anywhere</span>
        <h2>Edit here. Display there. <span class="fade">Same pixels.</span></h2>
        <p class="muted">Store JSON. Render it in the editor, in read-only mode, on the server, or in an email, and it looks identical, because it's literally the same serializer. No display component to keep in sync.</p>
        <a class="btn" href="/docs#rendering">Rendering docs <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <section class="wrap stats reveal">
    <h2>Everything you need. <span class="fade">Nothing you don't.</span></h2>
    <p class="sub-sm">One package, one CSS file, every framework. Numbers from the codebase, not a slide deck.</p>
    <div class="stat-grid">
      {stats.map(([n, label, icon, body], i) => (
        <div class="stat reveal" style={`--i:${i}`}>
          <span class="label"><Icon name={icon} />{label}</span>
          <b class="num" data-count={n}>{n}</b>
          <p>{body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap final reveal">
    <h2>Build the writing experience <br />your users <span class="grad-final">deserve.</span></h2>
    <div class="cta"><a class="btn primary lg" href="/playground"><Icon name="pen-nib" />Open the playground</a><a class="btn lg" href="/docs"><Icon name="book-open-text" />Read the docs</a><button class="pill" title="Click to copy"><Icon name="terminal-window" /><code id="copy">npm i @abhinavakhil/penna-core</code></button></div>
  </section>

  <style>
    /* ---- motion primitives ---- */
    .rise { opacity: 0; transform: translateY(18px); animation: rise .7s cubic-bezier(.2,.7,.2,1) forwards; animation-delay: calc(var(--i, 0) * 90ms); }
    @keyframes rise { to { opacity: 1; transform: none; } }
    .reveal { opacity: 0; transform: translateY(22px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); transition-delay: calc(var(--i, 0) * 70ms); }
    .reveal.in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) { .rise, .reveal { opacity: 1; transform: none; animation: none; transition: none; } .marquee .track { animation: none; } .typed { animation: none; width: auto; } .demo-nav .bar { display: none; } }

    /* ---- hero (ClickUp layout) ---- */
    @property --pa { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
    .hero { background: var(--card); }
    .hero-inner { max-width: 1120px; margin: 0 auto; padding: 80px 20px 64px; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
    .pill-tag { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 12px; border-radius: 54px; font-size: 14px; font-weight: 600; letter-spacing: -.01em; color: var(--fg); background: var(--code); position: relative; }
    .pill-tag::before { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1.5px; pointer-events: none; background: conic-gradient(from var(--pa), transparent 0 55%, #7b68ee 70%, #ff4fa3 80%, #49ccf9 90%, transparent 100%); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); mask-composite: exclude; animation: spin 3.5s linear infinite; }
    .pill-tag span { color: var(--muted); }
    @keyframes spin { to { --pa: 360deg; } }
    .hero h1 { margin: 0; max-width: 900px; font-size: clamp(38px, 5.2vw, 60px); font-weight: 700; line-height: 1.1; letter-spacing: -.035em; color: var(--fg); text-align: left; }
    .hero h1 .pri { display: block; }
    .hero h1 .sec { display: block; margin-top: 6px; font-size: clamp(24px, 3.4vw, 40px); line-height: 1.1; color: var(--muted); }
    .cta-row { display: flex; align-items: center; gap: 12px; margin-top: 12px; }
    .btn-hero { display: inline-flex; align-items: center; white-space: nowrap; height: 52px; padding: 0 20px; border-radius: 14px; background: var(--fg); color: var(--bg); font-weight: 700; font-size: 16px; letter-spacing: -.01em; transition: transform .15s, opacity .15s; }
    .btn-hero { gap: 10px; }
    .btn-hero :global(.ph) { font-size: 18px; transition: transform .2s; }
    .btn-hero:hover :global(.ph) { transform: translateX(3px); }
    .btn-hero:hover { transform: translateY(-1px); opacity: .92; }
    .micro { font-size: 12px; line-height: 18px; color: var(--muted); }

    /* ---- tabs + preview ---- */
    .tabs-wrap { position: relative; height: 580px; overflow: hidden; background: var(--bg); border-top: 1px solid var(--line); }
    .tabs-wrap::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 80px; background: linear-gradient(to bottom, transparent, var(--bg)); pointer-events: none; }
    .tabs-inner { max-width: 1120px; margin: 0 auto; padding: 0 20px; display: flex; align-items: flex-start; }
    .demo-nav { flex: none; width: 200px; display: flex; flex-direction: column; gap: 2px; padding: 12px 8px; }
    .demo-nav button { display: flex; align-items: center; gap: 10px; height: 30px; padding: 5px 12px 5px 10px; border: 0; background: none; color: var(--muted); font: inherit; font-size: 14px; font-weight: 600; letter-spacing: -.01em; text-align: left; border-radius: 8px; cursor: pointer; transition: color .2s, background .2s; position: relative; }
    .demo-nav button:hover { color: var(--fg); background: var(--code); }
    .demo-nav button { height: 36px; }
    .demo-nav button[aria-selected="true"] { color: var(--fg); background: var(--card); box-shadow: 0 0 0 1px var(--line), 0 2px 6px -2px rgba(0,0,0,.08); }
    .demo-nav :global(.ph) { font-size: 18px; color: var(--muted); transition: color .2s; }
    .demo-nav button:hover :global(.ph) { color: var(--fg); }
    .demo-nav button[aria-selected="true"] :global(.ph) { color: var(--accent); }
    .preview { flex: 1; min-width: 0; }
    .demo-frame { border: 1px solid var(--line); border-radius: 12px; background: var(--card); box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 12px 40px -12px rgba(0,0,0,.12); overflow: hidden; }
    .demo-hint { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--muted); padding: 10px 16px; border-bottom: 1px solid var(--line); background: var(--code); }
    .demo-hint::before { content: ""; width: 44px; height: 10px; flex: none; background: radial-gradient(circle, #f87171 4px, transparent 5px) 0 50%/14px 10px no-repeat, radial-gradient(circle, #fbbf24 4px, transparent 5px) 15px 50%/14px 10px no-repeat, radial-gradient(circle, #34d399 4px, transparent 5px) 30px 50%/14px 10px no-repeat; }
    .demo-frame :global(.penna) { border: 0; border-radius: 0; min-height: 600px; }
