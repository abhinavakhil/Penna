---
import '@abhinavakhil/penna-core/penna.css'
interface Props { title?: string; description?: string; wide?: boolean }
const { title = 'Penna — the editor that works everywhere', description = 'A beautiful, framework-agnostic WYSIWYG editor with slash commands, media, tables, Markdown and free AI. Works in React, Vue, Angular, Svelte, Solid or plain HTML.', wide = false } = Astro.props
const path = Astro.url.pathname
const links = [['/#features', 'Features'], ['/#install', 'Frameworks'], ['/#ai', 'AI'], ['/docs', 'Docs']]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=Lora:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&family=Merriweather:wght@400;700&family=Plus+Jakarta+Sans:wght@600;700;800&family=Sometype+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <style is:global>
      :root { --bg: #fafafa; --fg: #111318; --muted: #5f6673; --line: #e6e8ec; --card: #fff; --accent: #4f46e5; --accent-2: #06b6d4; --code: #f1f3f6; }
      @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --bg: #0a0c10; --fg: #e7e9ee; --muted: #9aa3b2; --line: #22262f; --card: #12151b; --accent: #8b8cf8; --accent-2: #22d3ee; --code: #171b23; } }
      :root[data-theme="dark"] { --bg: #0a0c10; --fg: #e7e9ee; --muted: #9aa3b2; --line: #22262f; --card: #12151b; --accent: #8b8cf8; --accent-2: #22d3ee; --code: #171b23; }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; font-family: Inter, ui-sans-serif, system-ui, sans-serif; background: var(--bg); color: var(--fg); line-height: 1.6; -webkit-font-smoothing: antialiased; }
      a { color: inherit; text-decoration: none; }
      code, pre, kbd { font-family: "Sometype Mono", ui-monospace, Menlo, monospace; }
      .penna, .penna-content { --pn-font: Inter, ui-sans-serif, system-ui, sans-serif; --pn-mono: "Sometype Mono", ui-monospace, Menlo, monospace; }
      .wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
      .wrap.wide { max-width: 1400px; }
      .announce { display: flex; align-items: center; justify-content: center; gap: 6px; height: 40px; padding: 0 16px; background: var(--code); color: var(--fg); font-size: 13px; letter-spacing: -.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .announce b { font-weight: 600; }
      .announce span { color: var(--muted); }
      header.site { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--card) 90%, transparent); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
      header.site .wrap { display: flex; align-items: center; gap: 44px; height: 60px; padding: 0 20px; max-width: 1120px; }
      .logo { display: flex; align-items: center; gap: 8px; font-family: "Plus Jakarta Sans", Inter, sans-serif; font-weight: 800; font-size: 20px; letter-spacing: -.03em; }
      .logo svg { width: 26px; height: 26px; }
      nav.links { display: flex; align-items: center; gap: 8px; }
      nav.links a { padding: 4px 10px; border-radius: 8px; font-size: 15px; font-weight: 500; color: var(--fg); letter-spacing: -.01em; transition: background .15s; }
      nav.links a:hover, nav.links a[aria-current="page"] { background: var(--code); }
      nav.main { display: flex; align-items: center; gap: 8px; margin-left: auto; }
      nav.main a { display: inline-flex; align-items: center; height: 32px; padding: 0 12px; border-radius: 8px; font-size: 14px; font-weight: 600; letter-spacing: -.01em; color: var(--fg); transition: background .15s, transform .15s; }
      nav.main a:first-child { font-weight: 500; color: var(--muted); padding: 0 10px; }
      nav.main a:first-child:hover { color: var(--fg); }
      nav.main a:nth-child(2) { background: var(--code); }
      nav.main a:nth-child(2):hover { background: color-mix(in srgb, var(--fg) 10%, var(--code)); }
      nav.main a:last-child { color: var(--bg); background: var(--fg); }
      nav.main a:last-child:hover { color: var(--bg); background: var(--fg); transform: translateY(-1px); }
      .theme-btn { border: 0; background: none; color: var(--muted); border-radius: 8px; width: 32px; height: 32px; cursor: pointer; display: grid; place-items: center; }
      .theme-btn:hover { background: var(--code); color: var(--fg); }
      .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 10px; font-weight: 600; font-size: 14px; border: 1px solid var(--line); background: var(--card); color: var(--fg); cursor: pointer; transition: transform .1s, box-shadow .1s; }
      .btn:hover { transform: translateY(-1px); border-color: color-mix(in srgb, var(--fg) 25%, var(--line)); }
      .btn.primary:hover { background: color-mix(in srgb, var(--fg) 88%, var(--accent)); }
      .btn.primary { background: var(--fg); color: var(--bg); border-color: var(--fg); }
      pre.code { background: #0f172a; color: #e2e8f0; padding: 14px 16px; border-radius: 10px; overflow: auto; font-size: 13px; line-height: 1.6; margin: 0; }
      pre.code .c { color: #64748b; } pre.code .k { color: #c084fc; } pre.code .s { color: #86efac; } pre.code .f { color: #7dd3fc; } pre.code .t { color: #fbbf24; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 24px; transition: border-color .2s, transform .2s; }
      .card:hover { border-color: color-mix(in srgb, var(--accent) 35%, var(--line)); transform: translateY(-2px); }
      h1, h2, h3 { font-family: "Plus Jakarta Sans", Inter, sans-serif; font-weight: 700; letter-spacing: -.035em; line-height: 1.12; margin: 0; }
      .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: var(--accent); }
      .eyebrow::before { content: ""; width: 18px; height: 2px; border-radius: 2px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); }
      footer.site { border-top: 1px solid var(--line); margin-top: 80px; padding: 32px 0; color: var(--muted); font-size: 14px; }
      footer.site .wrap { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; }
      @media (max-width: 860px) { nav.links { display: none; } }
      @media (max-width: 640px) { .announce .more { display: none; } header.site .wrap { gap: 12px; } nav.main { gap: 4px; } nav.main a { padding: 0 10px; font-size: 13px; } nav.main a:first-child { display: none; } .logo span { display: none; } .announce { font-size: 12px; } }
    </style>
    <slot name="head" />
  </head>
  <body>
    <a class="announce" href="/playground"><b>NEW in 0.2:</b> Shortcuts, proofreader &amp; a native Angular component<span class="more"> — plus version history, sepia and RTL</span> <span aria-hidden="true">›</span></a>
    <header class="site">
      <div class="wrap">
        <a class="logo" href="/" aria-label="Penna home">
          <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop stop-color="var(--accent)"/><stop offset="1" stop-color="var(--accent-2)"/></linearGradient></defs><path d="M27 4c-9 1-16 6-19 15l-3 9 9-3c9-3 14-10 15-19l-2-2Z" fill="url(#g)"/><path d="M8 24 20 12" stroke="var(--bg)" stroke-width="2" stroke-linecap="round"/></svg>
          <span>Penna</span>
        </a>
        <nav class="links" aria-label="Main">
          {links.map(([href, label]) => <a href={href} aria-current={href === '/docs' && path.startsWith('/docs') ? 'page' : undefined}>{label}</a>)}
        </nav>
        <nav class="main" aria-label="Actions">
          <a href="https://github.com/abhinavakhil" rel="noopener">GitHub</a>
          <a href="/playground">Playground</a>
          <a href="/docs">Get started</a>
        </nav>
        <button class="theme-btn" id="theme" aria-label="Toggle theme" title="Toggle theme">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </button>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Penna · MIT licensed · no telemetry, ever.</span>
        <span><a href="/docs">Docs</a> · <a href="/playground">Playground</a></span>
      </div>
    </footer>
    <script is:inline>
      const root = document.documentElement
      const saved = localStorage.getItem('penna-site-theme')
      if (saved) root.dataset.theme = saved
      document.getElementById('theme').addEventListener('click', () => {
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
        root.dataset.theme = dark ? 'light' : 'dark'
        localStorage.setItem('penna-site-theme', root.dataset.theme)
        document.querySelectorAll('.penna, .penna-content').forEach((el) => (el.dataset.theme = root.dataset.theme))
      })
    </script>
  </body>
</html>
