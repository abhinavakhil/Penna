{
  "name": "@abhinavakhil/penna-core",
  "version": "0.2.0",
  "description": "Framework-agnostic WYSIWYG editor core with slash commands, media, tables, markdown and more",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhinavakhil/Penna.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/abhinavakhil/Penna#readme",
  "keywords": [
    "editor",
    "wysiwyg",
    "rich-text",
    "prosemirror",
    "markdown"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./penna.css": "./dist/penna.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node -e \"require('fs').copyFileSync('src/penna.css','dist/penna.css')\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.3.2",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.2",
    "prosemirror-model": "^1.25.3",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.7.1",
    "prosemirror-transform": "^1.10.4",
    "prosemirror-view": "^1.40.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
